# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DATABASE=dovenue

# Email Configuration (SMTP)
# For development, you can use Ethereal Email (https://ethereal.email/)
# For production, use Gmail, SendGrid, AWS SES, or another SMTP service

SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_ethereal_user@ethereal.email
SMTP_PASS=your_ethereal_password
SMTP_FROM=noreply@dovenue.com

# Application URLs
# Set to https://dovenuesuite.com for production (Render dashboard env var)
FRONTEND_URL=https://dovenuesuite.com

# Public base URL of this backend service (used to build unsubscribe links
# in automated emails). Render sets RENDER_EXTERNAL_URL automatically, but
# set BACKEND_URL explicitly if that isn't reliable in your environment.
BACKEND_URL=https://your-backend.onrender.com

# Secret used to HMAC-sign one-click email unsubscribe links. Set a long
# random value in production — do not reuse any other secret.
EMAIL_UNSUBSCRIBE_SECRET=change_me_to_a_long_random_value

# JWT Configuration (if needed)
JWT_SECRET=your_jwt_secret_key_here

# Twilio Configuration (for SMS messaging)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+12345678900

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
# Webhook signing secret — run `stripe listen --print-secret` for local dev or copy from Stripe Dashboard > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Node Environment
NODE_ENV=development
