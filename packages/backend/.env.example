# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DATABASE=dovenue

# Email Configuration (SMTP)
# For development, you can use Ethereal Email (https://ethereal.email/)
# For production, use Gmail, SendGrid, AWS SES, or another SMTP service

SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_ethereal_user@ethereal.email
SMTP_PASS=your_ethereal_password
SMTP_FROM=noreply@dovenue.com

# Application URLs
# Set to https://dovenuesuite.com for production (Render dashboard env var)
FRONTEND_URL=https://dovenuesuite.com

# JWT Configuration (if needed)
JWT_SECRET=your_jwt_secret_key_here

# Twilio Configuration (for SMS messaging)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+12345678900

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
# Webhook signing secret — run `stripe listen --print-secret` for local dev or copy from Stripe Dashboard > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Optional: signing secret of a second destination that listens to events from connected accounts
STRIPE_CONNECT_WEBHOOK_SECRET=
# Auction Center: set true only once Stripe Tax is enabled; when false, auction orders carry no sales tax
STRIPE_TAX_ENABLED=false
# Auction Center master switch (public routes and the closing/charging/notification crons)
AUCTIONS_ENABLED=false

# Ticket Evolution (Victory Live) Exchange API
# Sandbox: https://api.sandbox.ticketevolution.com — Production: https://api.ticketevolution.com
TICKET_EVOLUTION_BASE_URL=https://api.sandbox.ticketevolution.com
TICKET_EVOLUTION_API_TOKEN=your_ticket_evolution_api_token_here
TICKET_EVOLUTION_API_SECRET=your_ticket_evolution_api_secret_here
# TEvo Hosted Checkout domain (no trailing slash) — prefixed to each event's relative `url` field
TICKET_EVOLUTION_CHECKOUT_BASE_URL=https://checkout.eventecos.com
# Long random string embedded in the order-webhook URL (TEvo webhooks are unsigned):
#   POST /ticket-evolution/webhooks/<secret>/production  (and /sandbox)
# Generate with: openssl rand -hex 32
TICKET_EVOLUTION_WEBHOOK_SECRET=
# Leave unset until go-live: the public TEvo feed is served to dev/local origins only.
# Set to true to serve it to every origin (e.g. www.eventecos.com).
TICKET_EVOLUTION_PUBLIC_FEED=

# Node Environment
NODE_ENV=development

# Allows the 'local-<userId>' dev auth bypass token used by local/dev tooling.
# Leave unset (or false) in any deployed environment — setting this to true lets
# anyone with a valid user ID impersonate that user with no password/token check.
ALLOW_LOCAL_DEV_AUTH=true
# Auction Center: secret (32+ chars) that signs bidder session tokens; required in production
AUCTION_SESSION_SECRET=

# Dashboard assistant: AI-written summary via Vercel AI Gateway (optional; the built-in summary works without it)
AI_GATEWAY_API_KEY=
# AI_ASSISTANT_MODEL=openai/gpt-4o-mini
